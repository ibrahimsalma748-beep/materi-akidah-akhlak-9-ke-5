<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Biografi & Keteladanan Utsman bin Affan</title>
    
    <!-- Fonts: Inter for UI, Amiri for Arabic -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        arabic: ['Amiri', 'serif'],
                    },
                    colors: {
                        emerald: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            800: '#065f46',
                            900: '#064e3b',
                        },
                        gold: {
                            400: '#fbbf24',
                            500: '#f59e0b',
                            600: '#d97706',
                        }
                    },
                    animation: {
                        'float': 'float 3s ease-in-out infinite',
                        'fade-in': 'fadeIn 0.5s ease-out forwards',
                        'slide-up': 'slideUp 0.6s ease-out forwards',
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-10px)' },
                        },
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        slideUp: {
                            '0%': { opacity: '0', transform: 'translateY(20px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        }
                    }
                }
            }
        }
    </script>

    <!-- html2pdf.js for Report Generation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <style>
        body {
            background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
            min-height: 100vh;
            overflow-x: hidden;
            -webkit-tap-highlight-color: transparent;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        }
        .hidden-screen { display: none !important; }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; height: 8px;}
        ::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb { background: #10b981; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #059669; }

        .arabic-text { direction: rtl; text-align: right; line-height: 2.2; }
        
        /* Toast Notification */
        #toast-container { position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 9999; display: flex; flex-direction: column; gap: 10px; width: 90%; max-width: 400px;}
        .toast { padding: 12px 20px; border-radius: 8px; color: white; font-weight: 600; text-align: center; box-shadow: 0 4px 6px rgba(0,0,0,0.1); animation: slideDown 0.3s ease-out forwards; }
        .toast.error { background-color: #ef4444; }
        .toast.success { background-color: #10b981; }
        .toast.info { background-color: #3b82f6; }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }

        /* Print formatting */
        @media print {
            body { background: white; }
            .no-print { display: none !important; }
            #pdf-content { display: block !important; padding: 0; margin: 0; color: black;}
        }
    </style>
</head>
<body class="text-gray-800 antialiased selection:bg-emerald-200 selection:text-emerald-900">

    <!-- TOAST CONTAINER -->
    <div id="toast-container"></div>

    <!-- 1. SPLASH SCREEN -->
    <div id="splash-screen" class="fixed inset-0 z-50 bg-emerald-700 flex flex-col items-center justify-center transition-opacity duration-500">
        <div class="animate-pulse-slow flex flex-col items-center">
            <i class="fas fa-book-open text-6xl text-gold-400 mb-4"></i>
            <h1 class="text-3xl md:text-5xl font-bold text-white tracking-wide text-center px-4">MPI Akidah Akhlak</h1>
            <p class="text-emerald-100 mt-2 text-lg">Membangun Karakter Generasi Qur'ani</p>
        </div>
        <div class="mt-8 w-16 h-16 border-4 border-emerald-500 border-t-gold-400 rounded-full animate-spin"></div>
    </div>

    <!-- 2. COVER SCREEN -->
    <div id="cover-screen" class="hidden-screen min-h-screen flex flex-col items-center justify-center p-4 relative overflow-hidden">
        <div class="absolute top-[-10%] left-[-10%] w-64 h-64 bg-emerald-300 rounded-full mix-blend-multiply filter blur-3xl opacity-50"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-80 h-80 bg-gold-300 rounded-full mix-blend-multiply filter blur-3xl opacity-50"></div>

        <div class="glass-panel rounded-3xl p-8 max-w-2xl w-full text-center relative z-10 animate-slide-up">
            <div class="inline-block bg-emerald-100 text-emerald-800 px-4 py-1 rounded-full text-sm font-semibold mb-4 border border-emerald-200 shadow-sm">
                Akidah Akhlak • MTs Kelas IX / Fase D
            </div>
            <h1 class="text-3xl md:text-5xl font-extrabold text-emerald-900 mb-2 leading-tight">
                Biografi & Keteladanan <br>
                <span class="text-gold-600">Utsman bin Affan</span>
            </h1>
            
            <div class="my-8 flex justify-center animate-float">
                <svg width="200" height="200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="100" cy="100" r="90" fill="#ecfdf5"/>
                    <path d="M100 20 L180 60 L180 140 L100 180 L20 140 L20 60 Z" fill="#d1fae5" stroke="#10b981" stroke-width="4"/>
                    <path d="M60 100 L90 130 L140 70" stroke="#d97706" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="100" cy="100" r="40" fill="#10b981" opacity="0.2"/>
                    <path d="M70 120 Q100 150 130 120" stroke="#065f46" stroke-width="4" fill="none" stroke-linecap="round"/>
                </svg>
            </div>

            <div class="flex flex-col md:flex-row gap-4 justify-center mt-6">
                <button onclick="toggleModal('modal-pengembang')" class="px-6 py-3 bg-white text-emerald-700 font-semibold rounded-xl border-2 border-emerald-200 hover:bg-emerald-50 hover:border-emerald-500 transition shadow-sm flex items-center justify-center gap-2">
                    <i class="fas fa-user-tie"></i> Info Pengembang
                </button>
                <button onclick="toggleModal('modal-tujuan')" class="px-6 py-3 bg-white text-emerald-700 font-semibold rounded-xl border-2 border-emerald-200 hover:bg-emerald-50 hover:border-emerald-500 transition shadow-sm flex items-center justify-center gap-2">
                    <i class="fas fa-bullseye"></i> Tujuan Pembelajaran
                </button>
            </div>
            
            <button onclick="navigate('cover-screen', 'login-screen')" class="mt-6 w-full md:w-auto px-10 py-4 bg-gradient-to-r from-emerald-600 to-emerald-500 text-white text-xl font-bold rounded-xl hover:from-emerald-700 hover:to-emerald-600 transition shadow-lg hover:shadow-emerald-500/50 flex items-center justify-center gap-3 mx-auto">
                MULAI BELAJAR <i class="fas fa-arrow-right"></i>
            </button>
        </div>

        <!-- MODAL PENGEMBANG -->
        <div id="modal-pengembang" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm transition-opacity">
            <div class="bg-white rounded-3xl p-6 max-w-md w-full shadow-2xl relative">
                <button onclick="toggleModal('modal-pengembang')" class="absolute top-4 right-4 text-gray-400 hover:text-red-500"><i class="fas fa-times text-2xl"></i></button>
                <div class="text-center">
                    <div class="w-24 h-24 mx-auto bg-emerald-100 rounded-full border-4 border-gold-400 overflow-hidden mb-4 shadow-inner relative flex items-center justify-center">
                        <span class="absolute text-3xl font-bold text-emerald-700 z-0">SI</span>
                        <img src="https://freeimage.host/i/nb06QVV" alt="Salma Ibrahim" class="w-full h-full object-cover relative z-10" onerror="this.style.display='none'">
                    </div>
                    <h2 class="text-2xl font-bold text-emerald-900">Salma Ibrahim, S.Pd.i</h2>
                    <p class="text-emerald-600 font-medium mb-1"><i class="fas fa-school"></i> MTs Al-Mubarak Marisa</p>
                    <p class="text-gray-500 text-sm mb-4"><i class="fas fa-envelope"></i> guru.madrasah@kemenag.go.id</p>
                    <div class="bg-gray-50 p-4 rounded-xl text-sm text-gray-600 border border-gray-100">
                        Senior Instructional Designer & Ahli Kurikulum Berbasis Cinta Kemenag RI.
                    </div>
                    <button onclick="toggleModal('modal-pengembang')" class="mt-6 w-full py-2 bg-emerald-100 text-emerald-800 font-semibold rounded-lg hover:bg-emerald-200 transition">Kembali ke Cover</button>
                </div>
            </div>
        </div>

        <!-- MODAL TUJUAN PEMBELAJARAN -->
        <div id="modal-tujuan" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm transition-opacity">
            <div class="bg-white rounded-3xl p-6 max-w-lg w-full shadow-2xl relative max-h-[90vh] overflow-y-auto custom-scrollbar">
                <button onclick="toggleModal('modal-tujuan')" class="absolute top-4 right-4 text-gray-400 hover:text-red-500"><i class="fas fa-times text-2xl"></i></button>
                <h2 class="text-2xl font-bold text-emerald-900 mb-4 border-b pb-2"><i class="fas fa-bullseye text-gold-500"></i> Tujuan Pembelajaran</h2>
                
                <div class="space-y-4 text-gray-700 text-justify">
                    <p class="font-medium">Melalui media ini, peserta didik mampu:</p>
                    <ul class="list-disc pl-5 space-y-2 bg-emerald-50 p-4 rounded-xl border border-emerald-100">
                        <li>Menganalisis biografi dan kepribadian luhur Utsman bin Affan r.a.</li>
                        <li>Mengurutkan proses kodifikasi Al-Qur'an dan nilai pengorbanannya.</li>
                        <li>Memecahkan masalah sosial dan konservasi (kepedulian lingkungan, khususnya di wilayah pesisir Pohuwato) berbekal inspirasi kedermawanan beliau secara tepat dan penuh cinta.</li>
                    </ul>

                    <div class="bg-gold-50 p-4 rounded-xl border border-gold-200">
                        <p class="text-sm font-bold text-gold-700 mb-2">Nilai Kurikulum Berbasis Cinta (KBC):</p>
                        <p class="text-sm italic">"Meneladani kedermawanan Utsman bin Affan untuk mewujudkan cinta kepada Allah, cinta sesama manusia, dan cinta kelestarian alam ciptaan-Nya di bumi Nusantara."</p>
                    </div>

                    <div class="text-center pt-2">
                        <p class="font-arabic arabic-text text-xl text-emerald-800">وَمَا يُلَقَّىٰهَآ إِلَّا ٱلَّذِينَ صَبَرُوا۟ وَمَا يُلَقَّىٰهَآ إِلَّا ذُو حَظٍّ عَظِيمٍ</p>
                        <p class="text-xs text-gray-500 mt-1">"Sifat-sifat yang baik itu tidak dianugerahkan melainkan kepada orang-orang yang sabar dan tidak dianugerahkan melainkan kepada orang-orang yang mempunyai keuntungan yang besar." (QS. Fussilat: 35)</p>
                    </div>

                    <button onclick="toggleModal('modal-tujuan')" class="w-full py-3 mt-4 bg-emerald-600 text-white font-semibold rounded-lg hover:bg-emerald-700 transition">Mengerti & Kembali</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. LOGIN SCREEN -->
    <div id="login-screen" class="hidden-screen min-h-screen flex flex-col items-center justify-center p-4">
        <div class="glass-panel rounded-3xl p-8 max-w-md w-full animate-slide-up">
            <div class="text-center mb-6">
                <i class="fas fa-user-graduate text-5xl text-emerald-600 mb-3"></i>
                <h2 class="text-2xl font-bold text-gray-800">Identitas Siswa</h2>
                <p class="text-gray-500 text-sm">Silakan isi data diri sebelum memulai.</p>
            </div>
            
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Nama Lengkap</label>
                    <input type="text" id="input-nama" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition bg-white/50" placeholder="Masukkan nama...">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Kelas</label>
                    <select id="input-kelas" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition bg-white/50">
                        <option value="">-- Pilih Kelas --</option>
                        <option value="IX-A">IX - A</option>
                        <option value="IX-B">IX - B</option>
                        <option value="IX-C">IX - C</option>
                    </select>
                </div>
                <button onclick="processLogin()" class="w-full py-4 bg-emerald-600 text-white font-bold rounded-xl hover:bg-emerald-700 transition mt-4 shadow-md flex justify-center items-center gap-2">
                    LANJUTKAN <i class="fas fa-sign-in-alt"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- 4. GUIDE & PENGANTAR SCREEN -->
    <div id="guide-screen" class="hidden-screen min-h-screen flex flex-col items-center justify-center p-4">
        <div class="glass-panel rounded-3xl p-6 md:p-10 max-w-3xl w-full relative animate-fade-in">
            <h2 class="text-2xl md:text-3xl font-bold text-emerald-900 mb-2">Selamat Datang, <span id="display-nama-guide" class="text-gold-600">Siswa</span>!</h2>
            <p class="text-gray-600 mb-6 border-b pb-4">Mari persiapkan diri untuk belajar sejarah dan keteladanan Islam.</p>
            
            <!-- Slides Container -->
            <div id="guide-slides" class="relative min-h-[250px] flex items-center justify-center text-center">
                <div class="guide-slide w-full transition-opacity duration-300 absolute inset-0 flex flex-col items-center justify-center">
                    <i class="fas fa-lock-open text-5xl text-emerald-500 mb-4"></i>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">Sistem Belajar Bertahap</h3>
                    <p class="text-gray-600 max-w-md mx-auto">Menu pada aplikasi ini terkunci secara berurutan. Selesaikan menu <b>BELAJAR</b> untuk membuka menu <b>BERMAIN</b>, dan seterusnya.</p>
                </div>
                <div class="guide-slide w-full transition-opacity duration-300 absolute inset-0 flex flex-col items-center justify-center opacity-0 pointer-events-none">
                    <i class="fas fa-map-marked-alt text-5xl text-blue-500 mb-4"></i>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">Konteks Wilayah Kita</h3>
                    <p class="text-gray-600 max-w-md mx-auto">Materi akan dikaitkan dengan kehidupan sehari-hari di Kabupaten Pohuwato, masyarakat pesisir, dan kelestarian Pantai Pohon Cinta.</p>
                </div>
                <div class="guide-slide w-full transition-opacity duration-300 absolute inset-0 flex flex-col items-center justify-center opacity-0 pointer-events-none">
                    <i class="fas fa-star-and-crescent text-5xl text-gold-500 mb-4"></i>
                    <h3 class="text-xl font-bold text-gray-800 mb-2">Kurikulum Berbasis Cinta</h3>
                    <p class="text-gray-600 max-w-md mx-auto">Tanamkan cinta kepada Allah, rasul, sesama manusia, dan alam sekitar melalui teladan Utsman bin Affan r.a.</p>
                </div>
            </div>

            <!-- Navigation Controls -->
            <div class="flex justify-between items-center mt-8">
                <button id="btn-guide-prev" onclick="changeGuideSlide(-1)" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition hidden">Kembali</button>
                <div class="flex gap-2 mx-auto" id="guide-dots">
                    <div class="w-3 h-3 rounded-full bg-emerald-600"></div>
                    <div class="w-3 h-3 rounded-full bg-gray-300"></div>
                    <div class="w-3 h-3 rounded-full bg-gray-300"></div>
                </div>
                <button id="btn-guide-next" onclick="changeGuideSlide(1)" class="px-4 py-2 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition ml-auto">Selanjutnya</button>
                <button id="btn-guide-finish" onclick="navigate('guide-screen', 'main-menu-screen'); initMainMenu();" class="px-6 py-2 bg-gradient-to-r from-gold-500 to-gold-400 text-white font-bold rounded-lg hover:from-gold-600 hover:to-gold-500 transition hidden ml-auto shadow-md">Ke Menu Utama</button>
            </div>
        </div>
    </div>

    <!-- 5. MAIN MENU (SEQUENTIAL LOCKING) -->
    <div id="main-menu-screen" class="hidden-screen min-h-screen flex flex-col p-4 md:p-8 max-w-5xl mx-auto">
        <div class="glass-panel rounded-2xl p-4 flex justify-between items-center mb-8 animate-slide-up">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-emerald-200 text-emerald-800 rounded-full flex items-center justify-center font-bold text-xl border-2 border-white shadow">
                    <span id="avatar-initial">S</span>
                </div>
                <div>
                    <h3 class="font-bold text-gray-800 text-lg leading-tight" id="display-nama-menu">Nama Siswa</h3>
                    <p class="text-sm text-emerald-600 font-medium" id="display-kelas-menu">Kelas</p>
                </div>
            </div>
            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/e/e9/Logo_Kementerian_Agama_Republik_Indonesia.png/600px-Logo_Kementerian_Agama_Republik_Indonesia.png" alt="Logo Kemenag" class="h-10 opacity-80" onerror="this.style.display='none'">
        </div>

        <div class="text-center mb-8 animate-slide-up" style="animation-delay: 0.1s">
            <h2 class="text-3xl font-extrabold text-emerald-900">Peta Perjalanan Belajar</h2>
            <p class="text-gray-600 mt-2">Selesaikan misi secara berurutan untuk menjadi insan yang berakhlak mulia.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 flex-grow animate-slide-up" style="animation-delay: 0.2s">
            <div onclick="openMenu('belajar')" class="glass-panel rounded-3xl p-6 cursor-pointer transform hover:-translate-y-2 transition duration-300 flex flex-col border-t-4 border-emerald-500 relative overflow-hidden group">
                <div class="absolute top-0 right-0 bg-emerald-500 text-white text-xs font-bold px-3 py-1 rounded-bl-xl z-10"><i class="fas fa-unlock"></i> TERBUKA</div>
                <div class="bg-emerald-100 w-20 h-20 rounded-full flex items-center justify-center mb-4 group-hover:scale-110 transition mx-auto">
                    <i class="fas fa-book-reader text-3xl text-emerald-600"></i>
                </div>
                <h3 class="text-xl font-bold text-center text-gray-800 mb-2">1. BELAJAR</h3>
                <p class="text-center text-sm text-gray-500 flex-grow">Pelajari biografi dan nilai-nilai luhur Utsman bin Affan r.a.</p>
                <div class="mt-4 w-full h-2 bg-gray-200 rounded-full overflow-hidden">
                    <div id="progress-belajar" class="h-full bg-emerald-500 w-0 transition-all duration-1000"></div>
                </div>
            </div>

            <div id="card-bermain" onclick="openMenu('bermain')" class="glass-panel rounded-3xl p-6 cursor-pointer transform transition duration-300 flex flex-col border-t-4 border-gray-400 relative overflow-hidden group opacity-75 grayscale hover:grayscale-0 focus:grayscale-0">
                <div id="badge-bermain" class="absolute top-0 right-0 bg-gray-500 text-white text-xs font-bold px-3 py-1 rounded-bl-xl z-10"><i class="fas fa-lock"></i> TERKUNCI</div>
                <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mb-4 mx-auto transition-transform">
                    <i class="fas fa-gamepad text-3xl text-blue-600"></i>
                </div>
                <h3 class="text-xl font-bold text-center text-gray-800 mb-2">2. BERMAIN</h3>
                <p class="text-center text-sm text-gray-500 flex-grow">Tantangan literasi interaktif menyelesaikan misi kebaikan.</p>
            </div>

            <div id="card-berlatih" onclick="openMenu('berlatih')" class="glass-panel rounded-3xl p-6 cursor-pointer transform transition duration-300 flex flex-col border-t-4 border-gray-400 relative overflow-hidden group opacity-75 grayscale hover:grayscale-0 focus:grayscale-0">
                <div id="badge-berlatih" class="absolute top-0 right-0 bg-gray-500 text-white text-xs font-bold px-3 py-1 rounded-bl-xl z-10"><i class="fas fa-lock"></i> TERKUNCI</div>
                <div class="bg-gold-100 w-20 h-20 rounded-full flex items-center justify-center mb-4 mx-auto transition-transform">
                    <i class="fas fa-tasks text-3xl text-gold-600"></i>
                </div>
                <h3 class="text-xl font-bold text-center text-gray-800 mb-2">3. BERLATIH</h3>
                <p class="text-center text-sm text-gray-500 flex-grow">Asesmen literasi & numerasi berjenjang untuk evaluasi.</p>
            </div>
        </div>
    </div>

    <!-- 6. LAYER MENU 1: BELAJAR -->
    <div id="belajar-screen" class="hidden-screen min-h-screen bg-white">
        <div class="bg-emerald-600 text-white p-4 sticky top-0 z-40 shadow-md flex justify-between items-center">
            <button onclick="navigate('belajar-screen', 'main-menu-screen')" class="text-white hover:bg-emerald-700 p-2 rounded-lg transition"><i class="fas fa-arrow-left"></i> Menu</button>
            <div class="font-bold text-lg">Materi Pembelajaran</div>
            <div class="text-sm bg-emerald-800 px-3 py-1 rounded-full"><span id="belajar-counter">1</span>/6</div>
