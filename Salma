            <div class="max-w-4xl mx-auto" id="belajar-quiz-container"></div>
        </div>
    </div>

    <!-- 7. LAYER MENU 2: BERMAIN -->
    <div id="bermain-screen" class="hidden-screen min-h-screen bg-blue-50">
